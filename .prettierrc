{
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "endOfLine": "lf",
  "insertPragma": false,
  "plugins": ["prettier-plugin-tailwindcss"],
  "printWidth": 79,
  "proseWrap": "preserve",
  "quoteProps": "as-needed",
  "requirePragma": false,
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "tailwindFunctions": ["clsx", "mergeClsx"],
  "tailwindStylesheet": "./src/app/globals.css",
  "tailwindAttributes": ["/.*ClassName$/"],
  "trailingComma": "es5",
  "useTabs": false
}
